{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://policy-cards.local/schema/policy-card-1.0.json",
  "title": "Policy card artifact (policy-card/1.0)",
  "type": "object",
  "required": ["schema", "card_id", "uri", "type", "title", "policy", "source", "content", "review"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "policy-card/1.0" },
    "card_id": { "type": "string", "pattern": "^PC-[A-Z0-9]+-[FRCP][0-9]{3}$" },
    "uri": { "type": "string", "pattern": "^pc://" },
    "type": { "enum": ["fact", "rule", "calculation", "procedure"] },
    "title": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "required": ["id", "version", "effective_from", "domain", "owner"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*$" },
        "effective_from": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "domain": { "type": "string" },
        "owner": { "type": "string" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loan_type": { "type": "string" },
        "lien": { "type": "string" },
        "occupancy": { "type": "string" },
        "channel": { "type": "string" }
      }
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["passage", "passage_id", "section", "start", "end", "quote"],
        "additionalProperties": false,
        "properties": {
          "passage": { "type": "string" },
          "passage_id": { "type": "string" },
          "section": { "type": "string" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "content": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "type": "string" }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "card_id"],
        "additionalProperties": false,
        "properties": {
          "type": { "const": "depends_on" },
          "card_id": { "type": "string" }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "required": ["tags"],
      "additionalProperties": false,
      "properties": {
        "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } }
      }
    },
    "quality": {
      "type": "object",
      "required": ["confidence", "machine_evaluable", "accepted_issues"],
      "additionalProperties": false,
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "machine_evaluable": { "type": "boolean" },
        "accepted_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "severity": { "enum": ["error", "warning", "info"] },
              "resolved": { "const": true }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": { "status": { "enum": ["pending", "approved", "rejected"] } }
    },
    "content_hash": {
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }]
    }
  }
}
